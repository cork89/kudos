{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mod-kudos",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "index.html"
      }
    }
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_COMMENT"]
    }
  },
  "media": {
    "dir": "assets"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.js"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "Kudos",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Add to Kudos",
        "description": "",
        "location": "comment",
        "forUserType": "user",
        "endpoint": "/internal/menu/add-to-kudos"
      },
      {
        "label": "Set Kudos Post",
        "description": "",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/set-current"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  },
  "dev": {
    "subreddit": "mod_kudos_dev"
  }
}
